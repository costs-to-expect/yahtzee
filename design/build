#!/usr/bin/env bash
#
# Builds the design mockups: design/src/*.html -> design/*.html, each one a single self-contained file.
# Run from anywhere: design/build
# Uses the same standalone Tailwind CLI as bin/css (run bin/css once if the binary is missing).

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) BINARY="tailwindcss-macos-arm64" ;;
    Darwin-x86_64) BINARY="tailwindcss-macos-x64" ;;
    Linux-aarch64|Linux-arm64) BINARY="tailwindcss-linux-arm64" ;;
    Linux-x86_64) BINARY="tailwindcss-linux-x64" ;;
    *) echo "Unsupported platform: $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac

if [ ! -x "${ROOT_DIR}/bin/${BINARY}" ]; then
    echo "Missing bin/${BINARY}, run bin/css once to download it." >&2
    exit 1
fi

CSS="$(mktemp)"
trap 'rm -f "$CSS"' EXIT

"${ROOT_DIR}/bin/${BINARY}" -i "${ROOT_DIR}/design/mockups.css" -o "$CSS" --minify 2>/dev/null

php "${ROOT_DIR}/design/inline.php" "$CSS"
